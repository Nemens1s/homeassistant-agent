# Copy to .env for dev mode (CLI REPL, evals, local uvicorn).
HA_BASE_URL=http://homeassistant.local:8123
# Long-lived access token (HA profile -> Security). SUPERVISOR_TOKEN also works.
HA_TOKEN=
LLM_URL=http://192.168.1.4:11434    # Ollama default; for llama.cpp use e.g. http://localhost:8080/v1
# Must be a model name served by the LLM backend.
LLM_MODEL=qwen3.5:4b
